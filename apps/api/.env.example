# Server-only API values. Do not prefix secrets with NEXT_PUBLIC_.

# Runtime and origins
NODE_ENV=development
DEPLOY_ENV=development
APP_VERSION=0.0.0-local
GIT_SHA=local
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated explicit reverse-proxy IPs/CIDRs. Never use a blanket trust value.
API_TRUST_PROXY=
# Production requires an injected distributed @fastify/rate-limit store adapter.
API_RATE_LIMIT_STORE_DRIVER=process_memory
# Required when API_RATE_LIMIT_STORE_DRIVER=redis. Production must use redis or an injected external store.
API_RATE_LIMIT_REDIS_URL=

# Supabase server, database, and local tooling
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy compatibility only. Prefer SUPABASE_SECRET_KEY for new backend work unless service-role privileges are explicitly required.
SUPABASE_SERVICE_ROLE_KEY=
PROFILE_AVATAR_BUCKET=profile-avatars
DATABASE_URL=
# Local Supabase CLI/MCP tooling only. Never expose this to browser bundles.
SUPABASE_ACCESS_TOKEN=
SUPABASE_MIGRATIONS_DB_URL=
SUPABASE_DIRECT_DB_URL=
SUPABASE_CLI_TIMEOUT_MS=45000
PGCONNECT_TIMEOUT=10

