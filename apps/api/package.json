{
  "name": "@veel/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "package.json",
    "src"
  ],
  "exports": {
    "./provider-event-replay-runtime": {
      "types": "./src/provider-event-replay-runtime.ts",
      "development": "./src/provider-event-replay-runtime.ts",
      "default": "./dist/provider-event-replay-runtime.js"
    },
    "./media-upload-provider": {
      "types": "./src/media-upload-provider.ts",
      "development": "./src/media-upload-provider.ts",
      "default": "./dist/media-upload-provider.js"
    },
    "./live-provider": {
      "types": "./src/live-provider.ts",
      "development": "./src/live-provider.ts",
      "default": "./dist/live-provider.js"
    }
  },
  "scripts": {
    "dev": "node --env-file=../../.env --import @veel/observability/register --watch --import tsx src/server.ts",
    "start": "node --import @veel/observability/register --env-file-if-exists=../../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.51.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.2",
    "@livepeer/core": "3.3.1",
    "@opentelemetry/api": "1.9.1",
    "@solana-commerce/solana-pay": "0.1.1",
    "@solana-program/token": "0.15.0",
    "@solana/kit": "7.1.0",
    "@solana/subscriptions": "0.5.0",
    "@solana/sysvars": "7.1.0",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.112.3",
    "@veel/config": "workspace:*",
    "@veel/contracts": "workspace:*",
    "@veel/observability": "workspace:*",
    "bs58": "^6.0.0",
    "fastestsmallesttextencoderdecoder": "1.0.22",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^6.0.1",
    "ioredis": "5.11.1",
    "jose": "6.2.9",
    "openapi-types": "^12.1.3",
    "postgres": "^3.4.9",
    "sharp": "0.35.3",
    "tweetnacl": "^1.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
