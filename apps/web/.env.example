# Browser-safe web values only.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy compatibility only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SOLANA_CHAIN=solana:devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_SUBSCRIPTIONS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=
NEXT_PUBLIC_TURNKEY_API_BASE_URL=https://api.turnkey.com
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_URL=
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Test-only browser auth bypass for E2E. Keep false outside automated test runs.
NEXT_PUBLIC_ENABLE_E2E_AUTH=false
# Keep false until Privy/Turnkey Solana runtime is verified on the target domain/device matrix.
NEXT_PUBLIC_EMBEDDED_WALLET_RUNTIME_ENABLED=false
