{
  "name": "@veel/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "node --conditions=development --env-file-if-exists=../../.env --import @veel/observability/register --watch --import tsx src/index.ts",
    "email:smoke": "tsx src/payment-confirmation-email-smoke.ts",
    "start": "node --import @veel/observability/register dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@solana-program/token": "0.15.0",
    "@solana/kit": "7.1.0",
    "@solana/subscriptions": "0.5.0",
    "@solana/sysvars": "7.1.0",
    "@solana/web3.js": "1.98.4",
    "@veel/api": "workspace:*",
    "@veel/config": "workspace:*",
    "@veel/observability": "workspace:*",
    "bs58": "6.0.0",
    "fastestsmallesttextencoderdecoder": "1.0.22",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.6"
  }
}
