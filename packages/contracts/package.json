{
  "name": "@veel/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "openapi.yaml",
    "package.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/openapi.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/generated/openapi.ts",
    "test": "vitest run --root ../.. packages/contracts/src/openapi-schema.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "^7.10.1",
    "yaml": "2.9.0"
  }
}
