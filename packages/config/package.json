{
  "name": "@veel/config",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./public": {
      "types": "./src/public.ts",
      "development": "./src/public.ts",
      "default": "./dist/public.js"
    },
    "./asset-amount": {
      "types": "./src/asset-amount.ts",
      "development": "./src/asset-amount.ts",
      "default": "./dist/asset-amount.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
