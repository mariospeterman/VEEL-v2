# WeVid isolated cloud staging. Never commit .env.staging.
# Each entry declares exposure, requirement and fail-closed behavior.

# 1. Core URLs and environment
NODE_ENV=production # public|required|runtime mode; staging guard still requires DEPLOY_ENV=staging
DEPLOY_ENV=staging # public|required|all operator commands reject any other target
WEB_URL="" # public|required|web health and provider returns; invalid URL blocks
API_URL="" # public|required|API health and provider callbacks; invalid URL blocks
NEXT_PUBLIC_APP_URL="" # public|required|browser origin; missing blocks web
NEXT_PUBLIC_API_BASE_URL="" # public|required|browser API origin; missing blocks web
APP_VERSION=staging # public|required|health and evidence label
GIT_SHA="" # public|required|exact release SHA; missing blocks acceptance
RELEASE_MANIFEST_PATH="" # public|required|immutable release manifest path; missing blocks proof
STAGING_FIXTURE_NAMESPACE="" # public|required|isolates fixtures; missing blocks seed/cleanup
STAGING_FIXTURE_USERS_JSON="" # secret|optional|existing WeVid user IDs only; missing disables staff fixture seed

# 2. Supabase Cloud
NEXT_PUBLIC_SUPABASE_URL="" # public|required|browser Auth/Realtime base; missing blocks
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="" # public|required|publishable browser key; missing blocks
SUPABASE_URL="" # public|required|server project URL; missing blocks
SUPABASE_PROJECT_REF="" # public|required|exact staging ref; production ref is rejected
SUPABASE_PRODUCTION_PROJECT_REF="" # secret|required safety comparison; missing blocks remote mutation
SUPABASE_PUBLISHABLE_KEY="" # public|required|server public operations; missing blocks
SUPABASE_SECRET_KEY="" # secret|required|server-only privileged operations; missing blocks
DATABASE_URL="" # secret|required|pooled runtime connection; missing blocks
SUPABASE_DIRECT_DB_URL="" # secret|required|migration/advisor connection; missing blocks migration tools
SUPABASE_MIGRATIONS_DB_URL="" # secret|optional|dedicated migration URL; falls back to direct URL
SUPABASE_ACCESS_TOKEN="" # secret|required|CLI project link; missing blocks cloud link

# 3. Redis and rate limiting
API_RATE_LIMIT_STORE_DRIVER=redis # public|required|staging must use Redis; other values are invalid
API_RATE_LIMIT_REDIS_URL="" # secret|required|shared rate limiting; missing blocks API readiness

# 4. Privy and external wallet
NEXT_PUBLIC_PRIVY_APP_ID="" # public|required|Privy browser app; missing disables embedded entry
PRIVY_APP_SECRET="" # secret|required|server verification; missing blocks Privy session exchange
PRIVY_JWKS_ENDPOINT="" # public|required|official JWKS URL; missing blocks Privy verification
NEXT_PUBLIC_EMBEDDED_WALLET_RUNTIME_ENABLED=true # public|required|only true for approved staging domain
NEXT_PUBLIC_SOLANA_CHAIN=solana:devnet # public|required|wrong network is invalid
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com # public|required|wallet connection; missing blocks

# 5. Solana devnet and Helius
SOLANA_CLUSTER=devnet # public|required|mainnet is invalid for staging acceptance
SOLANA_NETWORK=solana:devnet # public|required|mainnet is invalid
SOLANA_RPC_URL="" # secret|required|server settlement verification; missing blocks money journeys
PAYMENT_PLATFORM_FEE_WALLET="" # public|required|backend-owned recipient; missing blocks quotes
PAYMENT_USDC_MINT="" # public|required for USDC|missing disables USDC only
HELIUS_API_KEY="" # secret|optional|RPC/indexing; missing uses approved RPC fallback where supported
HELIUS_WEBHOOK_SECRET="" # secret|required|signed settlement evidence; missing blocks Helius proof
HELIUS_CLUSTER=devnet # public|required|mainnet is invalid

# 6. Bunny VOD and images
BUNNY_STREAM_API_KEY="" # secret|required|VOD create/delete; missing blocks video
BUNNY_STREAM_LIBRARY_ID="" # public|required|VOD library; missing blocks video
BUNNY_STREAM_EMBED_TOKEN_KEY="" # secret|required|signed playback; missing blocks private playback
BUNNY_STREAM_WEBHOOK_READONLY_KEY="" # secret|required|callback verification; missing blocks release
BUNNY_STORAGE_IMAGE_UPLOAD_ENABLED=true # public|required|false disables image upload
BUNNY_STORAGE_ACCESS_KEY="" # secret|required|private image objects; missing blocks image upload
BUNNY_STORAGE_ZONE_NAME="" # public|required|private image zone; missing blocks image upload
BUNNY_STORAGE_PULL_ZONE_URL="" # public|required|sanitized image delivery base; missing blocks playback
BUNNY_STORAGE_PULL_ZONE_TOKEN_KEY="" # secret|required|signed image delivery; missing blocks playback
BUNNY_STORAGE_API_ENDPOINT=https://storage.bunnycdn.com # public|required|official endpoint
BUNNY_PROOF_VIDEO_PATH=apps/web/public/video/Veel.mp4 # public|required|known-safe SFW fixture

# 7. Moderation
MEDIA_MODERATION_MODE=shadow # public|required|shadow never auto-releases; disabled_fail_closed blocks publication

# 8. Livepeer
LIVEPEER_API_KEY="" # secret|required|stream create/control; missing blocks live
LIVEPEER_WEBHOOK_SECRET="" # secret|required|callback verification; missing blocks live release
LIVEPEER_ACCESS_CONTROL_PRIVATE_KEY="" # secret|required|signed playback; missing blocks private playback
LIVEPEER_ACCESS_CONTROL_PUBLIC_KEY="" # public|required|playback verification; missing blocks
LIVEPEER_WEBHOOK_ID="" # public|required|dashboard callback identity; missing blocks
LIVEPEER_MODERATION_MULTISTREAM_TARGET_ID="" # public|required|SFW monitoring target; missing blocks release
LIVEPEER_ADULT_LIVE_ENABLED=false # public|required|true is invalid

# 9. Age, KYC and KYB
AGE_VERIFICATION_DRIVER="" # public|required|selected approved provider; missing blocks onboarding
AGE_VERIFICATION_ALLOW_MOCK_PROVIDER=false # public|required|true is invalid
DIDIT_API_KEY="" # secret|feature-gated|missing disables Didit
DIDIT_WEBHOOK_SECRET="" # secret|feature-gated|missing disables Didit callbacks
DIDIT_AGE_WORKFLOW_ID="" # public|feature-gated|missing disables Didit age
DIDIT_ADULT_PUBLISHER_WORKFLOW_ID="" # public|feature-gated|missing disables adult publishing
DIDIT_KYC_WORKFLOW_ID="" # public|feature-gated|missing disables creator KYC
DIDIT_KYB_WORKFLOW_ID="" # public|feature-gated|missing disables organization KYB

# 10. Realtime and push
REALTIME_JWT_PRIVATE_JWK="" # secret|required|private topic token signing; missing disables Realtime
REALTIME_JWT_KEY_ID="" # public|required|key selection; missing disables Realtime
REALTIME_JWT_ISSUER="" # public|required|exact API issuer; missing disables Realtime
NOTIFICATION_DEVICE_ENCRYPTION_KEY="" # secret|required|device endpoint encryption; missing disables push enrollment
WEB_PUSH_VAPID_SUBJECT="" # public|required|operator contact; missing disables push
WEB_PUSH_VAPID_PUBLIC_KEY="" # public|required|browser enrollment; missing disables push
WEB_PUSH_VAPID_PRIVATE_KEY="" # secret|required|worker delivery; missing disables push

# 11. Email
TRANSACTIONAL_EMAIL_PROVIDER=resend # public|required|disabled blocks required email proof
RESEND_API_KEY="" # secret|required|delivery; missing blocks email
TRANSACTIONAL_EMAIL_FROM="" # public|required|verified staging sender; missing blocks email
TRANSACTIONAL_EMAIL_SMOKE_TO="" # secret|required|controlled test recipient; missing blocks proof

# 12. Observability
OTEL_REQUIRED=true # public|required|false is invalid for staging
OTEL_SDK_DISABLED=false # public|required|true blocks observability proof
OTEL_EXPORTER_OTLP_ENDPOINT="" # secret|required|collector destination; missing blocks readiness
OTEL_EXPORTER_OTLP_HEADERS="" # secret|optional|collector auth; missing allowed only for unauthenticated private collector

# 13. Subscriptions
SUBSCRIPTIONS_ENABLED=false # public|required|false hides purchase CTAs and skips recurring proof
SUBSCRIPTIONS_PROVIDER=disabled # public|feature-gated|must be official program when enabled
SUBSCRIPTIONS_SOLANA_RPC_URL="" # secret|feature-gated|missing blocks enabled subscriptions
SUBSCRIPTIONS_DEFAULT_MINT="" # public|feature-gated|missing blocks enabled subscriptions
SUBSCRIPTIONS_COLLECTOR_WALLET="" # public|feature-gated|missing blocks enabled subscriptions
SUBSCRIPTIONS_COLLECTOR_PRIVATE_KEY="" # secret|feature-gated|server collector only; missing blocks enabled subscriptions

# 14. Enterprise
ENTERPRISE_STAGING_SESSION_COOKIE="" # secret|optional|controlled operator session; missing blocks Enterprise proof only
ENTERPRISE_STAGING_ORGANIZATION_ID="" # secret|optional|namespace fixture ID; missing blocks Enterprise proof only
ENTERPRISE_STAGING_RELATIONSHIP_ID="" # secret|optional|namespace fixture ID; missing blocks Enterprise proof only

# 15. MCP
MCP_ENABLED=false # public|required|false hides connector runtime without blocking social PWA
MCP_PUBLIC_BASE_URL="" # public|feature-gated|HTTPS required when enabled
MCP_AUTH_MODE=oauth # public|feature-gated|other production modes fail closed
MCP_REQUIRE_OAUTH=true # public|feature-gated|false is invalid when enabled

# 16. Legal and release
LEGAL_DOCUMENTS_APPROVED=false # public|required|set true only after owner/counsel approval; false blocks promotion
LEGAL_TERMS_VERSION="" # public|required|approved version; missing blocks promotion
LEGAL_PRIVACY_VERSION="" # public|required|approved version; missing blocks promotion
LEGAL_CONTACT_EMAIL="" # public|required|approved contact; missing blocks promotion

# 17. Operator acknowledgements and evidence
STAGING_SCHEMA_APPLY_ACK="" # secret|one-time|<project-ref>:<migration-head>; missing blocks apply
STAGING_BACKUP_ACK="" # secret|one-time|BACKUP_CONFIRMED_OR_DISPOSABLE_STAGING; missing blocks apply
STAGING_CLEANUP_ACK="" # secret|one-time|DELETE_FIXTURES:<namespace>; missing blocks cleanup
STAGING_EVIDENCE_BUNDLE_JSON="" # secret|required for proof|opaque receipt bundle only; missing blocks proof
STAGING_SESSION_COOKIE="" # secret|required for authenticated real-stack browser journeys; missing blocks those journeys
STAGING_ACCEPTANCE_OUTPUT=.staging/acceptance/latest.json # public|optional|ignored redacted result path

# Test bypasses are forbidden in real staging.
NEXT_PUBLIC_ENABLE_E2E_AUTH=false # public|required|true is invalid
ENABLE_E2E_AUTH=false # public|required|true is invalid
