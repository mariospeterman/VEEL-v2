{
  "name": "veel-shoot-own-shine",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/run-development.mjs",
    "dev:full": "VEEL_DEV_FULL=true node --env-file-if-exists=.env scripts/run-development.mjs",
    "bootstrap": "corepack enable && corepack prepare pnpm@10.0.0 --activate && pnpm install --frozen-lockfile",
    "check": "pnpm docs:check && pnpm ranking:policy && pnpm deps:check && pnpm frontend:affordances && pnpm db:migrations:check && pnpm deploy:check && pnpm lint && pnpm typecheck && pnpm test",
    "doctor": "bash scripts/toolchain-doctor.sh",
    "docs:check": "node scripts/check-docs.mjs",
    "ranking:policy": "node scripts/check-ranking-policy.mjs",
    "deps:check": "node scripts/check-dependency-policy.mjs",
    "audit:prod": "node scripts/audit-production-dependencies.mjs",
    "frontend:affordances": "node scripts/check-frontend-affordances.mjs",
    "scaffold:check": "pnpm docs:check",
    "build": "pnpm -r --if-present build",
    "deploy:check": "node scripts/check-deploy-readiness.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:verify": "node scripts/verify-release-manifest.mjs",
    "staging:init": "node scripts/staging-init.mjs",
    "staging:doctor": "node --env-file-if-exists=.env.staging scripts/staging-doctor.mjs",
    "staging:cloud:link": "node --env-file-if-exists=.env.staging scripts/staging-cloud-link.mjs",
    "staging:migrations:plan": "node --env-file-if-exists=.env.staging scripts/staging-migrations.mjs plan",
    "staging:migrations:apply": "node --env-file-if-exists=.env.staging scripts/staging-migrations.mjs apply",
    "staging:bootstrap": "node --env-file-if-exists=.env.staging scripts/staging-bootstrap.mjs",
    "staging:run": "node --env-file-if-exists=.env.staging scripts/staging-run.mjs",
    "staging:seed": "node --env-file-if-exists=.env.staging scripts/staging-fixtures.mjs seed",
    "staging:acceptance": "node --env-file-if-exists=.env.staging scripts/staging-acceptance.mjs",
    "staging:acceptance:headed": "STAGING_ACCEPTANCE_HEADED=true node --env-file-if-exists=.env.staging scripts/staging-acceptance.mjs",
    "staging:prove": "node --env-file-if-exists=.env.staging scripts/staging-prove.mjs",
    "staging:report": "node scripts/staging-report.mjs",
    "staging:cleanup": "node --env-file-if-exists=.env.staging scripts/staging-fixtures.mjs cleanup",
    "staging:acceptance:render": "node scripts/render-staging-acceptance.mjs",
    "synthetic:smoke": "node scripts/synthetic-smoke.mjs",
    "load:smoke": "node scripts/load-smoke.mjs",
    "db:backup": "node scripts/backup-supabase.mjs",
    "db:restore:prove": "node scripts/prove-backup-restore.mjs",
    "storage:restore:prove": "node scripts/prove-storage-restore.mjs",
    "db:migrations:check": "node packages/database/scripts/check-migrations.mjs",
    "contracts:generate": "pnpm --filter @veel/contracts generate",
    "database:check": "pnpm --filter @veel/database check",
    "database:legacy-bridge:check": "node scripts/apply-legacy-migration-bridge.mjs",
    "database:legacy-bridge:apply": "node scripts/apply-legacy-migration-bridge.mjs --apply",
    "supabase:version": "supabase --version",
    "supabase:link": "node --env-file-if-exists=.env scripts/run-supabase-cli.mjs link --project-ref-env",
    "supabase:migrations": "node --env-file-if-exists=.env scripts/run-supabase-cli.mjs migration list --connection-env",
    "supabase:history:check": "node --env-file-if-exists=.env scripts/check-supabase-migration-history.mjs",
    "supabase:advisors": "node --env-file-if-exists=.env scripts/run-supabase-cli.mjs db advisors --connection-env --type all --level warn --fail-on none",
    "supabase:push:dry": "node --env-file-if-exists=.env scripts/run-supabase-cli.mjs db push --connection-env --dry-run",
    "supabase:push": "node --env-file-if-exists=.env scripts/run-supabase-cli.mjs db push --connection-env",
    "mcp:seed": "node --env-file=.env scripts/seed-mcp-oauth-client.mjs",
    "mcp:oauth:pkce": "node --env-file=.env scripts/smoke-mcp-oauth-pkce.mjs",
    "mcp:smoke": "node --env-file=.env scripts/smoke-mcp-remote.mjs",
    "proof:bunny-sfw": "node --experimental-strip-types --env-file=.env apps/web/scripts/prove-bunny-sfw.mjs",
    "proof:subscriptions": "node --env-file=.env apps/worker/scripts/prove-solana-subscriptions.mjs",
    "proof:enterprise": "node --env-file=.env apps/api/scripts/prove-enterprise-managed-creators.mjs",
    "lint": "eslint .",
    "smoke": "node scripts/run-local-tool.mjs playwright test",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/run-local-tool.mjs vitest run && pnpm test:evidence",
    "test:evidence": "node --test scripts/generate-audit-evidence.test.mjs scripts/capture-audit-execution.test.mjs",
    "test:integration:api": "VEEL_ENABLE_REAL_API_INTEGRATION_TESTS=1 node --env-file-if-exists=.env scripts/run-local-tool.mjs vitest run --no-file-parallelism apps/api/test/*.integration.test.ts"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "1.14.5",
      "axios@>=1.15.2 <1.20.0": "1.20.0",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "decode-uri-component@<=0.5.0": "0.5.1",
      "fast-copy@>=3.0.0 <3.1.0": "3.1.0",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "4.2.3",
      "follow-redirects@>=1.16.0 <1.16.2": "1.16.2",
      "gaxios@7.1.3>rimraf": "-",
      "hono@<4.13.11": "4.13.11",
      "ip-address@<=10.7.3": "10.7.4",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "stream-json@<3.7.0": "3.7.0",
      "systeminformation@<5.33.16": "5.33.16",
      "jayson@4.3.0>uuid": "11.1.1",
      "uuid@>=8.0.0 <11.1.1": "11.1.1",
      "ws@>=8.0.0 <8.21.0": "8.21.3"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.5",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "31.0.0",
    "postgres": "^3.4.9",
    "supabase": "2.113.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.0.3",
    "@rolldown/binding-darwin-x64": "1.0.3"
  }
}
