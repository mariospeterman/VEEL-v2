# Public web values. Browser-safe only.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SOLANA_CHAIN=solana:devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_SUBSCRIPTIONS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=
NEXT_PUBLIC_TURNKEY_API_BASE_URL=
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_URL=
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Keep false until Privy/Turnkey Solana runtime is verified on the target domain/device matrix.
NEXT_PUBLIC_EMBEDDED_WALLET_RUNTIME_ENABLED=false

# Server-only API values. Never expose through NEXT_PUBLIC_.
NODE_ENV=development
APP_VERSION=0.0.0
GIT_SHA=local
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy compatibility only. Prefer SUPABASE_SECRET_KEY for new Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
PRIVY_APP_SECRET=
PRIVY_JWKS_ENDPOINT=

# Notification delivery. Generate a 32-byte base64/base64url value; server-only.
NOTIFICATION_DEVICE_ENCRYPTION_KEY=
# Server-only VAPID subject and private key plus browser-safe public key for web push.
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Transactional email for durable payment/withdrawal-waiver confirmations.
# Disabled unless a launch-approved provider, verified sending domain, and server-only API key are configured.
TRANSACTIONAL_EMAIL_PROVIDER=disabled
TRANSACTIONAL_EMAIL_FROM=
TRANSACTIONAL_EMAIL_REPLY_TO=
RESEND_API_KEY=
# Staging smoke only. Sends one synthetic durable-confirmation email when explicitly configured.
TRANSACTIONAL_EMAIL_SMOKE_TO=

# External MCP connector foundation. Disabled by default.
# Production private-data connectors require OAuth; scoped tokens are a dev/staging bridge only.
MCP_ENABLED=false
MCP_PUBLIC_BASE_URL=
MCP_AUTH_MODE=oauth
MCP_ALLOWED_CLIENTS=
MCP_REQUIRE_OAUTH=true
MCP_ALLOW_STATIC_TOKENS_DEV=false
MCP_TOOL_CALL_RATE_LIMIT_PER_MINUTE=30
MCP_CONNECTION_TOKEN_TTL_SECONDS=86400
MCP_OAUTH_AUTH_CODE_TTL_SECONDS=600
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_AUDIT_RETENTION_DAYS=365
MCP_OAUTH_SEED_PROFILE=custom-http-smoke
MCP_OAUTH_CLIENT_NAME=
MCP_OAUTH_CLIENT_TYPE=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_REDIRECT_URIS=
MCP_OAUTH_ALLOWED_SCOPES=
MCP_OAUTH_PUBLIC_CLIENT=true
MCP_OAUTH_CLIENT_SECRET=
MCP_TEST_ACCESS_TOKEN=
MCP_TEST_EXPECTED_TOOL=creator_get_profile
MCP_TEST_FORBIDDEN_TOOL=admin_list_payment_intents
MCP_TEST_CONNECTION_ID=

# Local tooling only. Keep out of CI unless a job explicitly needs Supabase CLI/MCP access.
SUPABASE_ACCESS_TOKEN=

# Solana / payment devnet values.
SOLANA_CLUSTER=devnet
SOLANA_NETWORK=solana:devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=
PAYMENT_DEFAULT_ASSET=SOL
PAYMENT_PLATFORM_FEE_WALLET=
PAYMENT_PLATFORM_TREASURY_WALLET=
PAYMENT_PLATFORM_FEE_BPS=1000
SOLANA_SUBSCRIPTION_DELEGATION_PROGRAM_ID=De1egAFMkMWZSN5rYXRj9CAdheBamobVNubTsi9avR44
SOLANA_SUBSCRIPTION_USDC_MINT=
SOLANA_SUBSCRIPTION_COLLECTOR_WALLET=
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTIONS_PROVIDER=disabled
SUBSCRIPTIONS_SOLANA_PROGRAM_ID=De1egAFMkMWZSN5rYXRj9CAdheBamobVNubTsi9avR44
SUBSCRIPTIONS_SOLANA_NETWORK=devnet
SUBSCRIPTIONS_SOLANA_RPC_URL=
SUBSCRIPTIONS_SUPPORTED_MINTS=
SUBSCRIPTIONS_DEFAULT_MINT=
SUBSCRIPTIONS_COLLECTOR_WALLET=
SUBSCRIPTIONS_MERCHANT_WALLET=
SUBSCRIPTIONS_REQUIRE_ONCHAIN_VERIFICATION=true

# Payment evidence / indexer.
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
HELIUS_CLUSTER=devnet
HELIUS_API_BASE_URL=
HELIUS_RPC_URL=
HELIUS_WEBHOOK_CLUSTER=

# Wallet funding/onramp. Funding only; not merchant checkout or payment proof.
ONRAMP_PROVIDER=disabled
ONRAMP_PURCHASE_CURRENCY=SOL
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_KEY_SECRET=
COINBASE_CDP_API_BASE_URL=https://api.cdp.coinbase.com
COINBASE_ONRAMP_DESTINATION_NETWORK=solana

# Media providers.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_EMBED_TOKEN_KEY=
BUNNY_STREAM_PLAYBACK_TOKEN_TTL_SECONDS=900
# Bunny Stream signed webhooks use the library read-only API key as the HMAC secret.
BUNNY_STREAM_WEBHOOK_READONLY_KEY=
LIVEPEER_API_KEY=
LIVEPEER_WEBHOOK_SECRET=
LIVEPEER_ACCESS_CONTROL_PRIVATE_KEY=
LIVEPEER_ACCESS_CONTROL_PUBLIC_KEY=
LIVEPEER_API_BASE_URL=
LIVEPEER_BROWSER_BROADCAST_REDIRECT_BASE_URL=
LIVEPEER_WEBHOOK_ID=
LIVEPEER_PLAYBACK_JWT_PUBLIC_KEY=
LIVEPEER_PLAYBACK_JWT_PRIVATE_KEY_PATH=

# Age/KYC providers. Server-only.
AGE_VERIFICATION_DRIVER=
AGE_VERIFICATION_ALLOW_MOCK_PROVIDER=false
AGE_VERIFICATION_PROVIDER_SELECTION_ENABLED=true
AGE_VERIFICATION_PREFER_REUSABLE_CREDENTIALS=true
AGE_VERIFICATION_REUSABLE_PROVIDERS=didit_reusable,yoti_digital_id,eudi_wallet,scytales
AGE_VERIFICATION_FALLBACK_PROVIDERS=didit_age_estimation,persona_document
AGE_VERIFICATION_FALLBACK_ORDER=reusable_credential,age_estimation,free_document,portable_credential,database_non_doc,document
AGE_VERIFICATION_REVERIFY_MODE=risk_or_expiry
# Used only when AGE_VERIFICATION_REVERIFY_MODE=fixed_interval. Default product policy is risk/provider-expiry based.
AGE_VERIFICATION_REVERIFY_DAYS=365
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=
SUMSUB_CREATOR_KYC_LEVEL_NAME=
SUMSUB_ORG_KYB_LEVEL_NAME=
SUMSUB_API_BASE_URL=https://api.sumsub.com
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_KYC_WORKFLOW_ID=
DIDIT_KYB_WORKFLOW_ID=
DIDIT_API_BASE_URL=https://verification.didit.me
YOTI_SDK_ID=
YOTI_API_TOKEN=
YOTI_NOTIFICATION_KEY_PATH=
YOTI_API_BASE_URL=https://age.yoti.com/api/v1
YOTI_LAUNCH_BASE_URL=https://age.yoti.com
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_API_BASE_URL=https://stationapi.veriff.com
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
PERSONA_TEMPLATE_ID=
PERSONA_API_BASE_URL=https://api.withpersona.com

# Deployment health gates. Configure in GitHub environment vars, not browser bundles.
DEPLOY_ENABLED=false
API_HEALTH_URL=
API_READY_URL=
