# WeVid environment
# Keep browser-safe NEXT_PUBLIC_* values separate from server-only secrets.
# Provider production paths stay disabled until the corresponding official dashboard/webhook setup is verified.

# Public web and browser-safe config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SOLANA_CHAIN=solana:devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_SUBSCRIPTIONS_URL=

# Embedded wallet browser SDKs
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=
NEXT_PUBLIC_TURNKEY_API_BASE_URL=https://api.turnkey.com
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_URL=
NEXT_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Keep false until Privy/Turnkey Solana runtime is verified on the target domain/device matrix.
NEXT_PUBLIC_EMBEDDED_WALLET_RUNTIME_ENABLED=false

# Runtime and origins
NODE_ENV=development
APP_VERSION=0.0.0-local
GIT_SHA=local
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Supabase server, database, and local tooling
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy compatibility only. Prefer SUPABASE_SECRET_KEY for new backend work unless service-role privileges are explicitly required.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Local Supabase CLI/MCP tooling only. Never expose this to browser bundles.
SUPABASE_ACCESS_TOKEN=

# Wallet auth, Solana, payments, and subscriptions
PRIVY_APP_SECRET=
PRIVY_JWKS_ENDPOINT=
SOLANA_CLUSTER=devnet
SOLANA_NETWORK=solana:devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=
PAYMENT_DEFAULT_ASSET=SOL
PAYMENT_PLATFORM_FEE_WALLET=
PAYMENT_PLATFORM_TREASURY_WALLET=
PAYMENT_PLATFORM_FEE_BPS=1000
SOLANA_SUBSCRIPTION_DELEGATION_PROGRAM_ID=De1egAFMkMWZSN5rYXRj9CAdheBamobVNubTsi9avR44
SOLANA_SUBSCRIPTION_USDC_MINT=
SOLANA_SUBSCRIPTION_COLLECTOR_WALLET=
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTIONS_PROVIDER=disabled
SUBSCRIPTIONS_SOLANA_PROGRAM_ID=De1egAFMkMWZSN5rYXRj9CAdheBamobVNubTsi9avR44
SUBSCRIPTIONS_SOLANA_NETWORK=devnet
SUBSCRIPTIONS_SOLANA_RPC_URL=
SUBSCRIPTIONS_SUPPORTED_MINTS=
SUBSCRIPTIONS_DEFAULT_MINT=
SUBSCRIPTIONS_COLLECTOR_WALLET=
SUBSCRIPTIONS_MERCHANT_WALLET=
SUBSCRIPTIONS_REQUIRE_ONCHAIN_VERIFICATION=true
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
HELIUS_CLUSTER=devnet
HELIUS_API_BASE_URL=
HELIUS_RPC_URL=
HELIUS_WEBHOOK_CLUSTER=
WALLET_AUTH_SESSION_TTL_SECONDS=604800

# Fiat onramp
ONRAMP_PROVIDER=disabled
ONRAMP_PURCHASE_CURRENCY=SOL
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_KEY_SECRET=
COINBASE_CDP_API_BASE_URL=https://api.cdp.coinbase.com
COINBASE_ONRAMP_DESTINATION_NETWORK=solana

# Media and live providers
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_EMBED_TOKEN_KEY=
BUNNY_STREAM_PLAYBACK_TOKEN_TTL_SECONDS=900
BUNNY_STREAM_WEBHOOK_READONLY_KEY=
LIVEPEER_API_KEY=
LIVEPEER_WEBHOOK_SECRET=
LIVEPEER_ACCESS_CONTROL_PRIVATE_KEY=
LIVEPEER_ACCESS_CONTROL_PUBLIC_KEY=
LIVEPEER_API_BASE_URL=
LIVEPEER_BROWSER_BROADCAST_REDIRECT_BASE_URL=
LIVEPEER_WEBHOOK_ID=
LIVEPEER_PLAYBACK_JWT_PUBLIC_KEY=
LIVEPEER_PLAYBACK_JWT_PRIVATE_KEY_PATH=

# Age assurance waterfall
AGE_VERIFICATION_DRIVER=
AGE_VERIFICATION_ALLOW_MOCK_PROVIDER=false
AGE_VERIFICATION_PROVIDER_SELECTION_ENABLED=true
AGE_VERIFICATION_PREFER_REUSABLE_CREDENTIALS=true
AGE_VERIFICATION_REUSABLE_PROVIDERS=didit_reusable,yoti_digital_id,eudi_wallet,scytales
AGE_VERIFICATION_FALLBACK_PROVIDERS=didit_age_estimation,persona_document
AGE_VERIFICATION_FALLBACK_ORDER=reusable_credential,age_estimation,free_document,portable_credential,database_non_doc,document
# Use risk_or_expiry so age is not repeatedly requested unless provider expiry, jurisdiction, suspicious activity, or creator/Studio policy requires it.
AGE_VERIFICATION_REVERIFY_MODE=risk_or_expiry
AGE_VERIFICATION_REVERIFY_DAYS=365
YOTI_SDK_ID=
YOTI_API_TOKEN=
YOTI_NOTIFICATION_KEY_PATH=
YOTI_API_BASE_URL=https://age.yoti.com/api/v1
YOTI_LAUNCH_BASE_URL=https://age.yoti.com

# Creator KYC and organization KYB providers
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
# Compatibility fallback. Prefer purpose-specific SUMSUB_CREATOR_KYC_LEVEL_NAME and SUMSUB_ORG_KYB_LEVEL_NAME in production.
SUMSUB_LEVEL_NAME=
SUMSUB_CREATOR_KYC_LEVEL_NAME=
SUMSUB_ORG_KYB_LEVEL_NAME=
SUMSUB_API_BASE_URL=https://api.sumsub.com
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_AGE_WORKFLOW_ID=
DIDIT_KYC_WORKFLOW_ID=
DIDIT_KYB_WORKFLOW_ID=
DIDIT_API_BASE_URL=https://verification.didit.me
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
# Compatibility fallback for age/creator documentary checks. Prefer PERSONA_CREATOR_KYC_TEMPLATE_ID and PERSONA_ORG_KYB_TEMPLATE_ID for creator/business compliance.
PERSONA_TEMPLATE_ID=
PERSONA_CREATOR_KYC_TEMPLATE_ID=
PERSONA_ORG_KYB_TEMPLATE_ID=
PERSONA_API_BASE_URL=https://api.withpersona.com
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_API_BASE_URL=https://stationapi.veriff.com

# Notifications and email
NOTIFICATION_DEVICE_ENCRYPTION_KEY=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
